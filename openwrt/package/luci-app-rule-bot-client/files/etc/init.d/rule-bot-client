#!/bin/sh /etc/rc.common
# shellcheck shell=sh disable=SC2034,SC3043

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/rule-bot-client
HELPER=/usr/libexec/rule-bot-client-openwrt
CONFIG=/var/run/rule-bot-client/config.json

start_service() {
	local enabled
	config_load rule_bot_client
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	[ -x "$PROG" ] || return 1
	[ -x "$HELPER" ] || return 1

	"$HELPER" initialize >/dev/null || return 1
	"$HELPER" generate >/dev/null || return 1

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG"
	procd_set_param user nobody
	procd_set_param group nogroup
	procd_set_param respawn 3600 5 5
	procd_set_param file "$CONFIG" /etc/config/rule_bot_client
	[ -f /etc/config/openclash ] && procd_append_param file /etc/config/openclash
	[ -f /etc/config/nikki ] && procd_append_param file /etc/config/nikki
	[ -f /etc/nikki/run/config.yaml ] && procd_append_param file /etc/nikki/run/config.yaml
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_set_param term_timeout 30
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger rule_bot_client openclash nikki
}
