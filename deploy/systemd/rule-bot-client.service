[Unit]
Description=Rule-Bot Client final-rule domain collector
Documentation=https://github.com/Aethersailor/Rule-Bot-Client
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rule-bot-client
Group=rule-bot-client
UMask=0077
ExecStartPre=/usr/bin/rule-bot-client --config /etc/rule-bot-client/config.json --check
ExecStart=/usr/bin/rule-bot-client --config /etc/rule-bot-client/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=rule-bot-client
StateDirectoryMode=0750
ConfigurationDirectory=rule-bot-client
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
