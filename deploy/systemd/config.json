{
  "version": 1,
  "output": "/var/lib/rule-bot-client/domains.txt",
  "domain_mode": "registrable_domain",
  "flush_interval": "5s",
  "include_failed_connections": true,
  "include_single_label_hosts": false,
  "auto_update": false,
  "rule_bot": {
    "enabled": false,
    "endpoint": "https://rule-bot.example.com/api/v1/rule-bot-client/replace-with-your-private-path",
    "token": "replace-with-your-rule-bot-token",
    "state_file": "/var/lib/rule-bot-client/rulebot-state.json",
    "send_existing": false
  },
  "instances": [
    {
      "name": "local",
      "url": "http://127.0.0.1:9090",
      "secret": "replace-with-your-mihomo-secret"
    }
  ]
}
